# ── Database ─────────────────────────────────────────────────────────────────
# Option A (preferred for Render): full connection string
DATABASE_URL=

# Option B: individual components (used if DATABASE_URL is not set)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional: override connection timeout in seconds (default: 30)
DB_CONNECT_TIMEOUT=

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production

# ── Frontend URL (used in email links sent by the backend) ────────────────────
FRONTEND_URL=https://vritan-pied.vercel.app

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_USERNAME=
ADMIN_EMAIL=
FROM_EMAIL=

# ── AI / OCR ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OCR_SPACE_API_KEY=

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=
